# OpenAI API Key (required)
OPENAI_API_KEY=sk-...

# Black Forest Labs FLUX API Key (optional, for fallback)
BFL_API_KEY=bfl_...

# Database (SQLite local or Turso)
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Cloudflare R2 Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=colouring-pages
R2_PUBLIC_URL=
R2_ENDPOINT=

# NextAuth.js
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Cost Controls
DAILY_COST_ALERT_USD=50
MONTHLY_COST_CAP_USD=500
